# =============================================================================
# NutriTrack-OS — Environment Configuration Example
# Copy this file to .env for local development: cp .env.example .env
# =============================================================================

# Application Branding & Default Profile
NEXT_PUBLIC_APP_NAME="NutriTrack OS"
NEXT_PUBLIC_USER_NAME="Demo User"

# Stateless JWT Authentication Secret (HS256 via jose)
JWT_SECRET="change-me-in-production-min-32-chars-secret-key"
DEFAULT_OWNER_PASSWORD="NutriTrack123!"

# SQLite Database (Prisma ORM - WAL Mode enabled automatically at runtime)
# Local dev: "file:./dev.db" | Production container: "file:/var/lib/nutritrack/data/nutritrack.db"
DATABASE_URL="file:./dev.db"

# Local Disk Storage for Compressed WebP Meal Photos (<= 400KB)
# Local dev: "./uploads" | Production container: "/var/lib/nutritrack/uploads"
UPLOAD_DIR="./uploads"

# Lookahead Inventory Alert Engine (Daily 18:00 Cron)
ALERT_RECIPIENT_EMAIL="user@example.com"
EMAIL_PROVIDER="SMTP" # Options: "SMTP" or "RESEND"

# Optional: SMTP Configuration (Can also be configured per-user via the Web UI)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Optional: Resend API Configuration
RESEND_API_KEY=""

# Reverse Proxy Domain (Used by Caddy Server in docker-compose.yml for automatic Let's Encrypt HTTPS)
DOMAIN_NAME="localhost"
